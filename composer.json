{
    "name": "omnibase/broadcast",
    "description": "A broadcast's site on omnibase: a programme, its episodes, what was played on stage (performances), the songs and who sang them - on omnibase/video's films and omnibase/music's performers.",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/glitchr-studio/omnibase-broadcast",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "support": {
        "source": "https://github.com/glitchr-studio/omnibase-broadcast",
        "issues": "https://github.com/glitchr-studio/omnibase-broadcast/issues"
    },
    "require": {
        "php": "^8.2",
        "doctrine/orm": "^2.15|^3.0",
        "omnibridge/symfony": "1.x-dev",
        "omniscient/omnibase": "3.0.*-dev || 4.0.*-dev",
        "omnibase/admin": "dev-main",
        "omnibase/music": "dev-main",
        "omnibase/video": "dev-main",
        "symfony/config": "^7.0|^8.0",
        "symfony/dependency-injection": "^7.0|^8.0",
        "symfony/http-kernel": "^7.0|^8.0",
        "symfony/twig-bundle": "^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Base\\Broadcast\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Base\\Broadcast\\Tests\\": "./tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

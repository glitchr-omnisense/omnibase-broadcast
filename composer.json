{
    "name": "omnibase/broadcast",
    "description": "A broadcast's site on omnibase: a programme, its episodes, what was played on stage (performances), the songs and who sang them - on omnibase/video's films and omnibase/music's performers.",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/glitchr-omnisense/omnibase-broadcast",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "support": {
        "source": "https://github.com/glitchr-omnisense/omnibase-broadcast",
        "issues": "https://github.com/glitchr-omnisense/omnibase-broadcast/issues"
    },
    "require": {
        "php": "^8.2",
        "doctrine/orm": "^2.15|^3.0",
        "doctrine/doctrine-bundle": "^2.13|^3.0",
        "omnibridge/symfony": "^1.1",
        "omnisense/omnibase": "^5.1",
        "omnibase/admin": "^1.0",
        "omnibase/music": "^1.0",
        "omnibase/video": "^1.0",
        "symfony/config": "^7.0|^8.0",
        "symfony/dependency-injection": "^7.0|^8.0",
        "symfony/http-kernel": "^7.0|^8.0",
        "symfony/twig-bundle": "^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Base\\Broadcast\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Base\\Broadcast\\Tests\\": "./tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "omnibridge/composer": true,
            "php-http/discovery": true
        }
    }
}
